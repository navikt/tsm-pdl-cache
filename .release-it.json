{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "commit": false,
    "requireBranch": "main",
    "requireCommits": true,
    "requireCommitsFail": false,
    "commitsPath": "client",
    "tagName": "v${version}"
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": true,
    "autoGenerate": true,
    "assets": ["client/build/libs/*.jar"]
  },
  "hooks": {
    "after:bump": "./gradlew :client:publish -Pversion=${version}"
  }
}
